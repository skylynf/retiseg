{
  "schema_id": "retiseg-clinical-review",
  "version": "1.0.0-pilot",
  "status": "pilot: may change after the pilot; frozen as 1.x before the main reading (docs/clinical/28 section 8)",
  "notes": "Codes are what the analysis reads; labels and help are what the reader sees. Never re-use a code for a different meaning; add a new code instead.",
  "steps": {
    "image_pre": {
      "title": "Image assessment",
      "intro": "Grade the photograph as you would in clinic. No outlines are shown yet. Zoom and adjust brightness freely.",
      "overlays": "none",
      "questions": [
        {
          "id": "pre_quality", "type": "single", "required": true,
          "label": "Image quality",
          "options": [
            {"code": "good", "label": "Good", "help": "All relevant areas assessable"},
            {"code": "adequate", "label": "Adequate", "help": "Minor limitations; grading not affected"},
            {"code": "poor", "label": "Poor but gradable", "help": "Limitations could affect grading"},
            {"code": "ungradable", "label": "Ungradable"}
          ]
        },
        {
          "id": "pre_quality_issues", "type": "multi", "required": false,
          "label": "Quality issues",
          "show_if": {"q": "pre_quality", "in": ["adequate", "poor", "ungradable"]},
          "options": [
            {"code": "blur", "label": "Blur / defocus"},
            {"code": "illumination", "label": "Uneven illumination / shadow"},
            {"code": "exposure", "label": "Under- or over-exposure"},
            {"code": "media", "label": "Media opacity / haze"},
            {"code": "artifact", "label": "Artifacts (dust, lashes, reflections)"},
            {"code": "vignetting", "label": "Small pupil / vignetting"},
            {"code": "coverage", "label": "Macula or disc not fully in field"},
            {"code": "other", "label": "Other"}
          ]
        },
        {
          "id": "pre_icdr", "type": "single", "required": true,
          "label": "Diabetic retinopathy grade (ICDR)",
          "options": [
            {"code": "0", "label": "0 No apparent retinopathy"},
            {"code": "1", "label": "1 Mild NPDR", "help": "Microaneurysms only"},
            {"code": "2", "label": "2 Moderate NPDR", "help": "More than microaneurysms, less than severe"},
            {"code": "3", "label": "3 Severe NPDR", "help": "4-2-1 rule, no PDR signs"},
            {"code": "4", "label": "4 PDR", "help": "Neovascularisation and/or vitreous or pre-retinal haemorrhage"},
            {"code": "cannot", "label": "Cannot grade"}
          ]
        },
        {
          "id": "pre_dme", "type": "single", "required": true,
          "label": "Diabetic macular oedema (ICDR, photographic surrogate)",
          "help": "Judged from hard exudates (and other signs of thickening visible on the photograph) relative to the foveal centre.",
          "options": [
            {"code": "absent", "label": "Absent", "help": "No exudates in the posterior pole"},
            {"code": "mild", "label": "Mild", "help": "Posterior-pole exudates distant from the centre"},
            {"code": "moderate", "label": "Moderate", "help": "Approaching the centre, not involving it"},
            {"code": "severe", "label": "Severe", "help": "Involving the foveal centre"},
            {"code": "cannot", "label": "Cannot assess"}
          ]
        },
        {
          "id": "pre_other_findings", "type": "multi", "required": false,
          "label": "Other findings (optional)",
          "options": [
            {"code": "irma", "label": "IRMA"},
            {"code": "nv", "label": "Neovascularisation (disc or elsewhere)"},
            {"code": "venous_beading", "label": "Venous beading"},
            {"code": "prh", "label": "Pre-retinal / vitreous haemorrhage"},
            {"code": "laser", "label": "Laser scars"},
            {"code": "drusen", "label": "Drusen / AMD"},
            {"code": "myelinated", "label": "Myelinated nerve fibres"},
            {"code": "occlusion", "label": "Signs of vein occlusion"},
            {"code": "hypertensive", "label": "Hypertensive changes"},
            {"code": "disc", "label": "Suspicious optic disc"},
            {"code": "pigment", "label": "Pigmented lesion / naevus"},
            {"code": "other", "label": "Other (comment)"}
          ]
        },
        {
          "id": "pre_fovea", "type": "point", "required": false,
          "label": "Foveal centre",
          "help": "Click Set, then click the foveal centre on the image. Skip if it is not visible."
        },
        {
          "id": "pre_disc", "type": "point", "required": false,
          "label": "Optic disc centre",
          "help": "Click Set, then click the centre of the disc. Skip if it is not visible."
        },
        {"id": "pre_comment", "type": "text", "required": false, "label": "Comment (optional)"}
      ]
    },
    "region_a": {
      "title": "Marked region: what is it?",
      "intro": "Look only inside the dashed circle. You are not told who marked it or why. Answer from the photograph.",
      "overlays": "marker",
      "questions": [
        {
          "id": "a_finding", "type": "single", "required": true, "columns": 2,
          "label": "Main finding in the circle",
          "options": [
            {"code": "ma", "group": "DR lesion", "label": "Microaneurysm"},
            {"code": "he", "group": "DR lesion", "label": "Intraretinal haemorrhage", "help": "Dot, blot or flame"},
            {"code": "ex", "group": "DR lesion", "label": "Hard exudate"},
            {"code": "se", "group": "DR lesion", "label": "Cotton-wool spot"},
            {"code": "irma", "group": "DR lesion", "label": "IRMA"},
            {"code": "nv", "group": "DR lesion", "label": "Neovascularisation"},
            {"code": "prh", "group": "DR lesion", "label": "Pre-retinal / vitreous haemorrhage"},
            {"code": "drusen", "group": "Other lesion", "label": "Drusen"},
            {"code": "laser", "group": "Other lesion", "label": "Laser scar"},
            {"code": "pigment", "group": "Other lesion", "label": "Pigment / naevus"},
            {"code": "other_lesion", "group": "Other lesion", "label": "Other lesion (comment)"},
            {"code": "vessel", "group": "Normal structure", "label": "Vessel, crossing or bifurcation"},
            {"code": "disc", "group": "Normal structure", "label": "Optic disc / peripapillary"},
            {"code": "reflex", "group": "Normal structure", "label": "Light reflex", "help": "Nerve-fibre sheen, foveal or vessel reflex"},
            {"code": "background", "group": "Normal structure", "label": "Normal background"},
            {"code": "artifact_dust", "group": "Artifact", "label": "Dust, smudge or eyelash"},
            {"code": "artifact_light", "group": "Artifact", "label": "Flare or reflection"},
            {"code": "artifact_edge", "group": "Artifact", "label": "Field edge / periphery distortion"},
            {"code": "indeterminate", "group": "Cannot tell", "label": "Cannot determine"}
          ]
        },
        {
          "id": "a_confidence", "type": "single", "required": true,
          "label": "Confidence",
          "show_if": {"q": "a_finding", "not_in": ["indeterminate"]},
          "options": [
            {"code": "certain", "label": "Certain"},
            {"code": "probable", "label": "Probable"},
            {"code": "possible", "label": "Possible"}
          ]
        },
        {
          "id": "a_multiple", "type": "flag", "required": false,
          "label": "The circle contains more than one distinct lesion"
        }
      ]
    },
    "region_b": {
      "title": "Marked region: what went wrong?",
      "intro": "Now the dataset annotation (solid) and the model (dashed) are shown inside this region's window. Your answer above is locked.",
      "overlays": "crop",
      "questions": [
        {
          "id": "b_cause", "type": "single", "required": true,
          "label": "Main explanation of the difference between the two outlines",
          "options": [
            {"code": "agree", "label": "No real difference", "help": "Both outlines acceptable"},
            {"code": "label_error", "label": "Dataset annotation wrong, model right"},
            {"code": "model_error", "label": "Model wrong, dataset annotation right"},
            {"code": "both_wrong", "label": "Both wrong"},
            {"code": "ambiguous", "label": "Definition-dependent", "help": "Reasonable graders could disagree (e.g. MA vs dot haemorrhage)"},
            {"code": "image_limited", "label": "Cannot be resolved from this photograph", "help": "Quality or resolution"}
          ]
        },
        {
          "id": "b_label_issue", "type": "multi", "required": true,
          "label": "What is wrong with the dataset annotation?",
          "show_if": {"q": "b_cause", "in": ["label_error", "both_wrong"]},
          "options": [
            {"code": "omission", "label": "Lesion present, not annotated"},
            {"code": "false_label", "label": "Annotated, but no lesion there"},
            {"code": "wrong_class", "label": "Annotated as the wrong lesion type"},
            {"code": "too_large", "label": "Outline too large / encloses several lesions or background"},
            {"code": "too_small", "label": "Outline incomplete or too small"},
            {"code": "offset", "label": "Outline misplaced"},
            {"code": "convention", "label": "Follows a dataset convention unlike clinical usage"},
            {"code": "other", "label": "Other (comment)"}
          ]
        },
        {
          "id": "b_model_issue", "type": "multi", "required": true,
          "label": "What is wrong with the model?",
          "show_if": {"q": "b_cause", "in": ["model_error", "both_wrong"]},
          "options": [
            {"code": "mimic_vessel", "group": "False alarm", "label": "Vessel, crossing or bifurcation taken for a lesion"},
            {"code": "mimic_disc", "group": "False alarm", "label": "Optic disc / peripapillary taken for a lesion"},
            {"code": "mimic_reflex", "group": "False alarm", "label": "Light reflex taken for a lesion"},
            {"code": "mimic_bright", "group": "False alarm", "label": "Drusen or other bright lesion taken for exudate / CWS"},
            {"code": "mimic_dark", "group": "False alarm", "label": "Pigment or other dark spot taken for a red lesion"},
            {"code": "artifact", "group": "False alarm", "label": "Triggered by an artifact"},
            {"code": "class_confusion", "group": "Wrong type", "label": "Right place, wrong lesion type"},
            {"code": "missed_small", "group": "Miss", "label": "Missed a small or faint lesion"},
            {"code": "missed_quality", "group": "Miss", "label": "Missed in a poor-quality area"},
            {"code": "missed_crowded", "group": "Miss", "label": "Missed next to other lesions or vessels"},
            {"code": "under_seg", "group": "Extent", "label": "Extent too small"},
            {"code": "over_seg", "group": "Extent", "label": "Extent too large / lesions merged"},
            {"code": "periphery", "group": "Other", "label": "Peripheral or wide-field distortion"},
            {"code": "other", "group": "Other", "label": "Other (comment)"}
          ]
        },
        {
          "id": "b_difficulty", "type": "single", "required": true,
          "label": "How hard is this region for a human grader?",
          "options": [
            {"code": "easy", "label": "Obvious to a trained grader"},
            {"code": "moderate", "label": "Needs careful inspection"},
            {"code": "hard", "label": "Hard even for a retina specialist"}
          ]
        },
        {
          "id": "b_impact", "type": "single", "required": true,
          "label": "Clinical consequence of this error, in this image",
          "help": "Assume the wrong outline (model or dataset, as you judged) were used to grade this image; everything else stays as you graded it.",
          "show_if": {"q": "b_cause", "not_in": ["agree"]},
          "options": [
            {"code": "0", "label": "0 None", "help": "No effect on any clinical decision"},
            {"code": "1", "label": "1 Minor", "help": "Lesion count or extent only; grade, DME and referral unchanged"},
            {"code": "2", "label": "2 Moderate", "help": "Changes the DR grade or DME category, not the referral decision"},
            {"code": "3", "label": "3 Major", "help": "Changes the referral decision or its urgency"}
          ]
        },
        {
          "id": "b_pivotal", "type": "single", "required": true,
          "label": "Is this lesion decisive on its own?",
          "help": "Decisive: this single finding by itself decides a grading threshold, e.g. the only microaneurysm (grade 0 vs 1), an exudate at the fovea (centre-involving DME), new vessels (PDR).",
          "show_if": {"q": "b_cause", "not_in": ["agree"]},
          "options": [
            {"code": "yes", "label": "Yes, decisive"},
            {"code": "no", "label": "No"},
            {"code": "unsure", "label": "Unsure"}
          ]
        },
        {
          "id": "b_decisions", "type": "multi", "required": false,
          "label": "Which decisions would change?",
          "show_if": {"q": "b_impact", "in": ["2", "3"]},
          "options": [
            {"code": "grade", "label": "DR grade"},
            {"code": "dme", "label": "DME assessment"},
            {"code": "referral", "label": "Referral (yes / no)"},
            {"code": "urgency", "label": "Urgency / follow-up interval"}
          ]
        },
        {
          "id": "b_fix", "type": "multi", "required": false,
          "label": "What would most reduce this kind of error? (optional)",
          "show_if": {"q": "b_cause", "not_in": ["agree"]},
          "options": [
            {"code": "guideline", "label": "Clearer lesion definitions / annotation guideline"},
            {"code": "reannotate", "label": "Re-annotation by retina specialists"},
            {"code": "more_examples", "label": "More training examples of this pattern"},
            {"code": "resolution", "label": "Higher image resolution"},
            {"code": "quality_control", "label": "Image quality control"},
            {"code": "taxonomy", "label": "More lesion classes (IRMA, NV, drusen ...)"},
            {"code": "context", "label": "More context (whole image, other eye, prior visits)"},
            {"code": "other_modality", "label": "Another modality (OCT, FA)"},
            {"code": "not_fixable", "label": "Not fixable from a single photograph"},
            {"code": "other", "label": "Other (comment)"}
          ]
        },
        {"id": "b_teaching", "type": "flag", "required": false, "label": "Good teaching or example case"},
        {"id": "b_comment", "type": "text", "required": false, "label": "What went wrong here? (free text)"}
      ]
    },
    "image_post": {
      "title": "Image summary",
      "intro": "All outlines of the whole image are now shown. Toggle the dataset annotation, the model and the heat map to compare.",
      "overlays": "all",
      "questions": [
        {
          "id": "post_model_grade", "type": "single", "required": true,
          "label": "Grading this image from the model's lesions alone would give",
          "options": [
            {"code": "same", "label": "The same grade as mine"},
            {"code": "lower1", "label": "One grade lower"},
            {"code": "lower2", "label": "Two or more grades lower"},
            {"code": "higher1", "label": "One grade higher"},
            {"code": "higher2", "label": "Two or more grades higher"},
            {"code": "cannot", "label": "Cannot say"}
          ]
        },
        {
          "id": "post_model_referral", "type": "single", "required": true,
          "label": "Referral decision from the model's lesions alone",
          "help": "Referable: moderate NPDR or worse, and/or DME.",
          "options": [
            {"code": "same", "label": "Same as mine"},
            {"code": "under", "label": "Would miss a referral"},
            {"code": "over", "label": "Would cause an unnecessary referral"},
            {"code": "cannot", "label": "Cannot say"}
          ]
        },
        {
          "id": "post_annotation_quality", "type": "single", "required": true,
          "label": "Overall quality of the dataset annotation for this image",
          "options": [
            {"code": "good", "label": "Good"},
            {"code": "acceptable", "label": "Acceptable"},
            {"code": "poor", "label": "Poor"}
          ]
        },
        {
          "id": "post_model_quality", "type": "single", "required": true,
          "label": "Overall quality of the model's lesion map for this image",
          "options": [
            {"code": "good", "label": "Good"},
            {"code": "acceptable", "label": "Acceptable"},
            {"code": "poor", "label": "Poor"}
          ]
        },
        {
          "id": "post_reference_grade", "type": "single", "required": false,
          "label": "The dataset's own grade for this image is shown above. Do you agree?",
          "show_if": {"case_has": "reference_grade"},
          "options": [
            {"code": "agree", "label": "Agree"},
            {"code": "too_low", "label": "Dataset grade too low"},
            {"code": "too_high", "label": "Dataset grade too high"},
            {"code": "unsure", "label": "Unsure"}
          ]
        },
        {"id": "post_key_problem", "type": "text", "required": false, "label": "Most clinically important problem in this image (optional)"}
      ]
    },
    "debrief": {
      "title": "Debrief",
      "intro": "A few questions about the review as a whole. They take about five minutes.",
      "overlays": "none",
      "questions": [
        {"id": "d_cost_ma", "type": "single", "required": false, "label": "In screening, how costly is a missed microaneurysm?",
         "options": [{"code": "low", "label": "Low"}, {"code": "medium", "label": "Medium"}, {"code": "high", "label": "High"}]},
        {"id": "d_cost_he", "type": "single", "required": false, "label": "... a missed haemorrhage?",
         "options": [{"code": "low", "label": "Low"}, {"code": "medium", "label": "Medium"}, {"code": "high", "label": "High"}]},
        {"id": "d_cost_ex", "type": "single", "required": false, "label": "... a missed hard exudate?",
         "options": [{"code": "low", "label": "Low"}, {"code": "medium", "label": "Medium"}, {"code": "high", "label": "High"}]},
        {"id": "d_cost_se", "type": "single", "required": false, "label": "... a missed cotton-wool spot?",
         "options": [{"code": "low", "label": "Low"}, {"code": "medium", "label": "Medium"}, {"code": "high", "label": "High"}]},
        {"id": "d_cost_fp", "type": "single", "required": false, "label": "How costly is a false lesion (false alarm) in screening?",
         "options": [{"code": "low", "label": "Low"}, {"code": "medium", "label": "Medium"}, {"code": "high", "label": "High"}]},
        {"id": "d_use", "type": "multi", "required": false, "label": "Where would pixel-level lesion maps be useful?",
         "options": [
           {"code": "triage", "label": "Screening triage"}, {"code": "grading_support", "label": "Supporting a human grader"},
           {"code": "dme", "label": "DME detection"}, {"code": "quantification", "label": "Lesion quantification over follow-up"},
           {"code": "trials", "label": "Clinical-trial endpoints"}, {"code": "teaching", "label": "Teaching"}, {"code": "none", "label": "Nowhere"}]},
        {"id": "d_missing_classes", "type": "multi", "required": false, "label": "Which classes should a lesion benchmark add?",
         "options": [
           {"code": "irma", "label": "IRMA"}, {"code": "nv", "label": "Neovascularisation"}, {"code": "venous_beading", "label": "Venous beading"},
           {"code": "prh", "label": "Pre-retinal / vitreous haemorrhage"}, {"code": "laser", "label": "Laser scars"}, {"code": "drusen", "label": "Drusen"},
           {"code": "landmarks", "label": "Fovea and disc landmarks"}, {"code": "other", "label": "Other (comment)"}]},
        {"id": "d_taxonomy", "type": "text", "required": false, "label": "Answer options that were missing or unclear"},
        {"id": "d_priorities", "type": "text", "required": false, "label": "What should the field prioritise next?"},
        {"id": "d_tool", "type": "text", "required": false, "label": "Comments on the tool"}
      ]
    }
  }
}
