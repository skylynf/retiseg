{
  "schema_id": "retiseg-clinical-review",
  "version": "3.0.0",
  "status": "formal batch (docs/clinical/28 section 8); frozen before the first reader opens the pack; wording-only changes afterwards (3.0.x)",
  "changes": "3.0.0 (2026-11-03, docs/clinical/32): after the trial with Dr. Peranut Chotcomwongse. Removed the AI grade / referral questions (the AI gives no grade). DME is the closest hard exudate to the fovea on the ETDRS grid (central subfield 1 mm, inner ring 1-3 mm, outer ring 3-6 mm; within 1 DD = central + inner), with a grid overlay in the tool. Fovea and disc are marked before grading (the grid needs both). 'Who is right?' is split into one status question for the dataset label and one for the AI, so 'both wrong' and 'both right' follow from the two answers. The ICDR consequence separates HEX within 1 DD of the fovea from HEX in the central subfield. IRMA and NV locations can be marked. 2.0.0 (2026-10-29, docs/clinical/31): clinical labels MA / HG / HEX / CWS; fewer questions.",
  "notes": "Codes are what the analysis reads; labels and help are what the reader sees. Never re-use a code for a different meaning. Lesion codes map to the dataset classes: ma=MA, hg=HE, hex=EX, cws=SE.",
  "etdrs": {
    "fovea_disc_um": 4500,
    "central_um": 500,
    "inner_um": 1500,
    "outer_um": 3000,
    "dd_um": 1500
  },
  "steps": {
    "image_pre": {
      "title": "Grade the image",
      "intro": "Mark the fovea and the disc first; the ETDRS grid then appears on the image (E to hide). No outlines are shown yet.",
      "overlays": "none",
      "questions": [
        {
          "id": "pre_quality",
          "type": "single",
          "required": true,
          "label": "Image quality",
          "options": [
            {
              "code": "good",
              "label": "Gradable"
            },
            {
              "code": "limited",
              "label": "Gradable with limitations"
            },
            {
              "code": "ungradable",
              "label": "Ungradable"
            }
          ]
        },
        {
          "id": "pre_fovea",
          "type": "point",
          "required": true,
          "allow_not_visible": true,
          "label": "Foveal center",
          "help": "Click Set, then click the fovea. Centers the ETDRS grid."
        },
        {
          "id": "pre_disc",
          "type": "point",
          "required": true,
          "allow_not_visible": true,
          "label": "Optic disc center",
          "help": "Sets the grid scale and the nasal side."
        },
        {
          "id": "pre_icdr",
          "type": "single",
          "required": true,
          "label": "ICDR DR grade",
          "options": [
            {
              "code": "0",
              "label": "No DR"
            },
            {
              "code": "1",
              "label": "Mild NPDR",
              "help": "MA only"
            },
            {
              "code": "2",
              "label": "Moderate NPDR",
              "help": "More than MA, less than severe"
            },
            {
              "code": "3",
              "label": "Severe NPDR",
              "help": "4-2-1 rule"
            },
            {
              "code": "4",
              "label": "PDR",
              "help": "NV, vitreous or preretinal hemorrhage"
            },
            {
              "code": "cannot",
              "label": "Cannot grade"
            }
          ]
        },
        {
          "id": "pre_dme",
          "type": "single",
          "required": true,
          "label": "DME on the photograph: closest HEX to the fovea",
          "help": "Photographs cannot measure thickness (OCT central subfield thickness); the closest hard exudate on the ETDRS grid is the surrogate. Within 1 DD = central subfield or inner ring.",
          "options": [
            {
              "code": "none",
              "label": "No HEX on the grid",
              "help": "None within 3 mm"
            },
            {
              "code": "outer",
              "label": "Outer ring only",
              "help": "1.5-3 mm"
            },
            {
              "code": "inner",
              "label": "Inner ring",
              "help": "0.5-1.5 mm; within 1 DD"
            },
            {
              "code": "central",
              "label": "Central subfield",
              "help": "Within 0.5 mm of the fovea (C)"
            },
            {
              "code": "cannot",
              "label": "Cannot assess"
            }
          ]
        },
        {
          "id": "pre_other_signs",
          "type": "multi",
          "required": false,
          "label": "Signs beyond the four lesion types (optional)",
          "help": "Not labelled in the datasets, but they drive severe NPDR and PDR.",
          "options": [
            {
              "code": "irma",
              "label": "IRMA"
            },
            {
              "code": "nv",
              "label": "NVD / NVE"
            },
            {
              "code": "venous_beading",
              "label": "Venous beading"
            },
            {
              "code": "prh",
              "label": "Preretinal / vitreous hemorrhage"
            },
            {
              "code": "laser",
              "label": "Laser scars"
            },
            {
              "code": "other",
              "label": "Other (comment at the end of the image)"
            }
          ]
        },
        {
          "id": "pre_marks",
          "type": "points",
          "required": false,
          "label": "Mark IRMA and NV (optional)",
          "help": "Click a button, then click each location on the image.",
          "show_if": {
            "q": "pre_other_signs",
            "in": [
              "irma",
              "nv"
            ]
          },
          "kinds": [
            {
              "code": "irma",
              "label": "IRMA"
            },
            {
              "code": "nv",
              "label": "NV"
            }
          ]
        }
      ]
    },
    "region_a": {
      "title": "What is in the circle?",
      "intro": "Answer from the photograph alone. You are not told who marked the region or why.",
      "overlays": "marker",
      "questions": [
        {
          "id": "a_finding",
          "type": "single",
          "required": true,
          "columns": 2,
          "label": "Main finding",
          "options": [
            {
              "code": "ma",
              "group": "The four lesion types",
              "label": "MA",
              "help": "Microaneurysm"
            },
            {
              "code": "hg",
              "group": "The four lesion types",
              "label": "HG",
              "help": "Intraretinal hemorrhage"
            },
            {
              "code": "hex",
              "group": "The four lesion types",
              "label": "HEX",
              "help": "Hard exudate"
            },
            {
              "code": "cws",
              "group": "The four lesion types",
              "label": "CWS",
              "help": "Cotton wool spot"
            },
            {
              "code": "irma",
              "group": "Other retinal findings",
              "label": "IRMA"
            },
            {
              "code": "nv",
              "group": "Other retinal findings",
              "label": "NV"
            },
            {
              "code": "prh",
              "group": "Other retinal findings",
              "label": "Preretinal / vitreous hemorrhage"
            },
            {
              "code": "drusen",
              "group": "Other retinal findings",
              "label": "Drusen"
            },
            {
              "code": "laser",
              "group": "Other retinal findings",
              "label": "Laser scar"
            },
            {
              "code": "pigment",
              "group": "Other retinal findings",
              "label": "Pigment / nevus"
            },
            {
              "code": "other_lesion",
              "group": "Other retinal findings",
              "label": "Other (comment in step B)"
            },
            {
              "code": "vessel",
              "group": "Normal anatomy",
              "label": "Vessel, crossing or bifurcation"
            },
            {
              "code": "disc",
              "group": "Normal anatomy",
              "label": "Optic disc / peripapillary"
            },
            {
              "code": "reflex",
              "group": "Normal anatomy",
              "label": "Light reflex",
              "help": "NFL sheen, foveal or vessel reflex"
            },
            {
              "code": "background",
              "group": "Normal anatomy",
              "label": "Normal retina"
            },
            {
              "code": "artifact_dust",
              "group": "Artifact",
              "label": "Dust, smudge or eyelash"
            },
            {
              "code": "artifact_light",
              "group": "Artifact",
              "label": "Flare or reflection"
            },
            {
              "code": "artifact_edge",
              "group": "Artifact",
              "label": "Field edge / periphery distortion"
            },
            {
              "code": "indeterminate",
              "group": "Cannot tell",
              "label": "Cannot determine"
            }
          ]
        },
        {
          "id": "a_confidence",
          "type": "single",
          "required": true,
          "label": "Confidence",
          "show_if": {
            "q": "a_finding",
            "not_in": [
              "indeterminate"
            ]
          },
          "options": [
            {
              "code": "certain",
              "label": "Certain"
            },
            {
              "code": "probable",
              "label": "Probable"
            },
            {
              "code": "possible",
              "label": "Possible"
            }
          ]
        }
      ]
    },
    "region_b": {
      "title": "Judge both outlines",
      "intro": "Dataset label: solid line. AI: dashed line. Shown inside this region's window only; your answer above is locked.",
      "overlays": "crop",
      "questions": [
        {
          "id": "b_label",
          "type": "single",
          "required": true,
          "columns": 2,
          "label": "Dataset label in this region",
          "options": [
            {
              "code": "correct",
              "label": "Correct"
            },
            {
              "code": "extent",
              "label": "Right lesion, wrong extent",
              "help": "Too large, too small or merged"
            },
            {
              "code": "wrong_type",
              "label": "Wrong lesion type"
            },
            {
              "code": "false",
              "label": "Marks a non-lesion"
            },
            {
              "code": "missed",
              "label": "Misses a lesion"
            },
            {
              "code": "unsure",
              "label": "Can't decide"
            }
          ]
        },
        {
          "id": "b_ai",
          "type": "single",
          "required": true,
          "columns": 2,
          "label": "AI in this region",
          "options": [
            {
              "code": "correct",
              "label": "Correct"
            },
            {
              "code": "extent",
              "label": "Right lesion, wrong extent",
              "help": "Too large, too small or merged"
            },
            {
              "code": "wrong_type",
              "label": "Wrong lesion type"
            },
            {
              "code": "false",
              "label": "Marks a non-lesion"
            },
            {
              "code": "missed",
              "label": "Misses a lesion"
            },
            {
              "code": "unsure",
              "label": "Can't decide"
            }
          ]
        },
        {
          "id": "b_unsure_why",
          "type": "single",
          "required": true,
          "label": "Why can't you decide?",
          "show_if": {
            "any": [
              {
                "q": "b_label",
                "in": [
                  "unsure"
                ]
              },
              {
                "q": "b_ai",
                "in": [
                  "unsure"
                ]
              }
            ]
          },
          "options": [
            {
              "code": "definition",
              "label": "Depends on definition",
              "help": "e.g. MA vs small dot HG"
            },
            {
              "code": "image",
              "label": "Image quality or resolution"
            }
          ]
        },
        {
          "id": "b_icdr",
          "type": "multi",
          "required": true,
          "label": "If the wrong outline were used to grade this eye, what would change?",
          "help": "Judged against your own grading of this image; the region's ETDRS location is shown above.",
          "show_if": {
            "any": [
              {
                "q": "b_label",
                "not_in": [
                  "correct"
                ]
              },
              {
                "q": "b_ai",
                "not_in": [
                  "correct"
                ]
              }
            ]
          },
          "options": [
            {
              "code": "none",
              "exclusive": true,
              "label": "Nothing",
              "help": "Grade and DME unchanged"
            },
            {
              "code": "g01",
              "label": "No DR ↔ mild NPDR",
              "help": "The only MA in the eye"
            },
            {
              "code": "g12",
              "label": "Mild ↔ moderate NPDR",
              "help": "The only HG, HEX or CWS in an MA-only eye; referral threshold"
            },
            {
              "code": "dme_1dd",
              "label": "DME: HEX within 1 DD",
              "help": "Inner ring or closer; referable DME on photographs"
            },
            {
              "code": "dme_cs",
              "label": "DME: HEX in the central subfield",
              "help": "Within 0.5 mm; closest to center-involving"
            },
            {
              "code": "g23",
              "label": "Moderate ↔ severe NPDR",
              "help": "4-2-1 rule: >20 HG in each of 4 quadrants"
            }
          ]
        },
        {
          "id": "b_relevance",
          "type": "single",
          "required": true,
          "label": "Would it change what you do for this patient?",
          "show_if": {
            "any": [
              {
                "q": "b_label",
                "not_in": [
                  "correct"
                ]
              },
              {
                "q": "b_ai",
                "not_in": [
                  "correct"
                ]
              }
            ]
          },
          "options": [
            {
              "code": "no",
              "label": "No",
              "help": "e.g. a small lesion far from the fovea"
            },
            {
              "code": "followup",
              "label": "Follow-up interval"
            },
            {
              "code": "referral",
              "label": "Referral or treatment"
            },
            {
              "code": "unsure",
              "label": "Unsure"
            }
          ]
        },
        {
          "id": "b_comment",
          "type": "text",
          "required": false,
          "label": "Comment (optional)"
        }
      ]
    },
    "image_post": {
      "title": "Whole image",
      "intro": "All outlines are now shown. Toggle the dataset label, the AI, the heat map and the grid to compare.",
      "overlays": "all",
      "questions": [
        {
          "id": "post_unlabelled",
          "type": "single",
          "required": true,
          "label": "Lesions missing from the dataset label",
          "options": [
            {
              "code": "none",
              "label": "None"
            },
            {
              "code": "few_peripheral",
              "label": "A few, outside the grid"
            },
            {
              "code": "few_central",
              "label": "A few, including on the grid"
            },
            {
              "code": "many",
              "label": "Many"
            }
          ]
        },
        {
          "id": "post_label_quality",
          "type": "single",
          "required": true,
          "label": "Dataset label for this image",
          "options": [
            {
              "code": "good",
              "label": "Good"
            },
            {
              "code": "acceptable",
              "label": "Acceptable"
            },
            {
              "code": "poor",
              "label": "Poor"
            }
          ]
        },
        {
          "id": "post_ai_quality",
          "type": "single",
          "required": true,
          "label": "AI lesion map for this image",
          "options": [
            {
              "code": "good",
              "label": "Good"
            },
            {
              "code": "acceptable",
              "label": "Acceptable"
            },
            {
              "code": "poor",
              "label": "Poor"
            }
          ]
        },
        {
          "id": "post_reference_grade",
          "type": "single",
          "required": false,
          "label": "The dataset's own grade is shown above. Do you agree?",
          "show_if": {
            "case_has": "reference_grade"
          },
          "options": [
            {
              "code": "agree",
              "label": "Agree"
            },
            {
              "code": "too_low",
              "label": "Too low"
            },
            {
              "code": "too_high",
              "label": "Too high"
            },
            {
              "code": "unsure",
              "label": "Unsure"
            }
          ]
        },
        {
          "id": "post_comment",
          "type": "text",
          "required": false,
          "label": "Comment on this image (optional)"
        }
      ]
    },
    "debrief": {
      "title": "Feedback",
      "intro": "About five minutes.",
      "overlays": "none",
      "questions": [
        {
          "id": "d_useful",
          "type": "text",
          "required": false,
          "label": "Which questions were useful, and which were not?"
        },
        {
          "id": "d_options",
          "type": "text",
          "required": false,
          "label": "Answer options that were missing, unclear or not in clinical terms"
        },
        {
          "id": "d_dme",
          "type": "text",
          "required": false,
          "label": "Did the ETDRS grid and the DME question work for you? What would you change?"
        },
        {
          "id": "d_use",
          "type": "multi",
          "required": false,
          "label": "Where would AI lesion maps be useful?",
          "options": [
            {
              "code": "triage",
              "label": "Screening triage"
            },
            {
              "code": "grading_support",
              "label": "Supporting a human grader"
            },
            {
              "code": "dme",
              "label": "DME detection"
            },
            {
              "code": "quantification",
              "label": "Lesion counts over follow-up"
            },
            {
              "code": "trials",
              "label": "Clinical-trial endpoints"
            },
            {
              "code": "teaching",
              "label": "Teaching"
            },
            {
              "code": "none",
              "label": "Nowhere"
            }
          ]
        },
        {
          "id": "d_missing_classes",
          "type": "multi",
          "required": false,
          "label": "Which lesion types should future datasets annotate?",
          "options": [
            {
              "code": "irma",
              "label": "IRMA"
            },
            {
              "code": "nv",
              "label": "NVD / NVE"
            },
            {
              "code": "venous_beading",
              "label": "Venous beading"
            },
            {
              "code": "prh",
              "label": "Preretinal / vitreous hemorrhage"
            },
            {
              "code": "laser",
              "label": "Laser scars"
            },
            {
              "code": "drusen",
              "label": "Drusen"
            },
            {
              "code": "landmarks",
              "label": "Fovea and disc"
            },
            {
              "code": "other",
              "label": "Other (comment)"
            }
          ]
        },
        {
          "id": "d_fix",
          "type": "multi",
          "required": false,
          "label": "What would most improve lesion AI for clinical use?",
          "options": [
            {
              "code": "guideline",
              "label": "Clearer lesion definitions"
            },
            {
              "code": "reannotate",
              "label": "Re-annotation by retina specialists"
            },
            {
              "code": "more_classes",
              "label": "IRMA and NV in the datasets"
            },
            {
              "code": "resolution",
              "label": "Higher image resolution"
            },
            {
              "code": "quality_control",
              "label": "Image quality control"
            },
            {
              "code": "location",
              "label": "Weighting by ETDRS location"
            },
            {
              "code": "other_modality",
              "label": "OCT or FA alongside"
            },
            {
              "code": "other",
              "label": "Other (comment)"
            }
          ]
        },
        {
          "id": "d_tool",
          "type": "text",
          "required": false,
          "label": "Comments on the tool"
        }
      ]
    }
  }
}
